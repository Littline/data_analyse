---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import NotFound from '../../components/NotFound.astro';
import { listPosts } from '../../lib/posts';
import { decodePathParam } from '../../utils/format';

const tag = decodePathParam(Astro.params.tag ?? '');
const posts = (await listPosts()).filter((post) => post.data.tags.includes(tag));

if (posts.length === 0) {
  Astro.response.status = 404;
}
---

{
  posts.length === 0 ? (
    <BaseLayout title="标签不存在">
      <NotFound title="没有找到这个标签" message={`标签「${tag}」下暂时没有文章。`} />
    </BaseLayout>
  ) : (
    <BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的全部文章`}>
      <div class="container container--wide">
        <h1 class="page-title">#{tag}</h1>
        <p class="page-subtitle">
          共 {posts.length} 篇文章 · <a href="/tags/">返回全部标签</a>
        </p>

        <ul class="post-list">
          {posts.map((post) => (
            <PostCard post={post} showTags={false} />
          ))}
        </ul>
      </div>
    </BaseLayout>
  )
}

