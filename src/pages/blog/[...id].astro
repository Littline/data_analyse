---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/NotFound.astro';
import Toc from '../../components/Toc.astro';
import Comments from '../../components/Comments.astro';
import { siteConfig } from '../../consts';
import { isAdmin } from '../../lib/auth';
import { listComments } from '../../lib/comments';
import { getPost, listPosts, renderPost } from '../../lib/posts';
import {
  decodePathParam,
  excerptOf,
  formatDate,
  isoDate,
  postUrl,
  readingTime,
  tagUrl,
} from '../../utils/format';
import { buildToc } from '../../utils/toc';

const id = decodePathParam(Astro.params.id ?? '');
const includeDrafts = isAdmin(Astro.cookies);
const post = await getPost(id, { includeDrafts });

if (!post) {
  Astro.response.status = 404;
}

const posts = post ? await listPosts({ includeDrafts }) : [];
const index = post ? posts.findIndex((item) => item.id === post.id) : -1;
const prev = index >= 0 ? (posts[index + 1] ?? null) : null; // 更早一篇
const next = index > 0 ? (posts[index - 1] ?? null) : null; // 更新一篇

const rendered = post ? await renderPost(post) : null;
const toc = rendered ? buildToc(rendered.headings) : [];
const comments = post ? await listComments(post.id) : [];
---

{
  !post || !rendered ? (
    <BaseLayout title="文章不存在">
      <NotFound title="文章不存在" message="这篇文章可能已经被删除或改名，也可能是尚未发布的草稿。" />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={post.data.title}
      description={excerptOf(post, 160)}
      publishedAt={post.data.pubDate}
      updatedAt={post.data.updatedDate}
      ogType="article"
      cover={post.data.cover}
    >
      <article class="container">
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <div class="post-meta">
            <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            <span>{post.data.author ?? siteConfig.author}</span>
            <span>{readingTime(post.body)} 分钟阅读</span>
            {post.data.category && <span>{post.data.category}</span>}
            {comments.length > 0 && (
              <span>
                <a href="#comments">{comments.length} 条评论</a>
              </span>
            )}
            {post.data.draft && <span class="badge-draft">草稿（仅登录后可见）</span>}
          </div>
          {post.data.updatedDate && (
            <div class="post-meta" style="margin-top: 0.4rem;">
              <span>最后更新：{formatDate(post.data.updatedDate)}</span>
            </div>
          )}
          {post.data.tags.length > 0 && (
            <ul class="tag-list" style="margin-top: 1rem;">
              {post.data.tags.map((tag) => (
                <li>
                  <a class="tag" href={tagUrl(tag)}>
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {isAdmin(Astro.cookies) && (
            <p style="margin-top: 1rem; font-size: 0.9rem;">
              <a href={`/admin/editor/?id=${encodeURIComponent(post.id)}`}>编辑这篇文章</a>
            </p>
          )}
        </header>

        {post.data.cover && (
          <div class="post-cover">
            <img src={post.data.cover} alt={post.data.title} />
          </div>
        )}

        <Toc headings={toc} />

        <div class="prose" set:html={rendered.html} />

        <Comments postId={post.id} comments={comments} />

        <footer class="post-footer">
          <span style="color: var(--text-mute);">感谢阅读，转载请注明出处。</span>
          <a href="/blog/">← 返回文章列表</a>
        </footer>

        {(prev || next) && (
          <nav class="post-nav" aria-label="上下篇">
            <div class="post-nav__item">
              {prev ? (
                <>
                  <span>上一篇</span>
                  <a href={postUrl(prev)}>{prev.data.title}</a>
                </>
              ) : (
                <span style="color: var(--text-mute);">已经是第一篇</span>
              )}
            </div>
            <div class="post-nav__item post-nav__item--next">
              {next ? (
                <>
                  <span>下一篇</span>
                  <a href={postUrl(next)}>{next.data.title}</a>
                </>
              ) : (
                <span style="color: var(--text-mute);">已经是最新一篇</span>
              )}
            </div>
          </nav>
        )}
      </article>
    </BaseLayout>
  )
}
