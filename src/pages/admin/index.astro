---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { authEnabled } from '../../lib/auth';
import { contentDir, listPosts, listProblems } from '../../lib/posts';
import { formatDate, isoDate, postUrl, tagUrl } from '../../utils/format';

const posts = await listPosts({ includeDrafts: true });
const problems = await listProblems();
const saved = Astro.url.searchParams.get('saved');
const deleted = Astro.url.searchParams.get('deleted');
const savedPost = saved ? posts.find((post) => post.id === saved) : null;
---

<AdminLayout title="文章管理">
  <h1 class="page-title" style="margin-top: 1.5rem;">文章管理</h1>
  <p class="page-subtitle">
    共 {posts.length} 篇文章 · 内容目录 <code>{contentDir()}</code>
  </p>

  {!authEnabled() && (
    <div class="admin-alert admin-alert--warn">
      <strong>当前没有设置管理密码。</strong>
      任何能访问本站的人都可以打开 <code>/admin/</code> 发布或删除文章。
      同时草稿也会被公开看到。如果要放到公网上，请先设置环境变量 <code>ADMIN_PASSWORD</code>
      再启动服务（见 README）。
    </div>
  )}

  {savedPost && (
    <div class="admin-alert admin-alert--ok">
      保存成功，已生成 <code>src/content/blog/{savedPost.id}.md</code>，文章现在已经出现在网站上：
      <a href={postUrl(savedPost)} target="_blank" rel="noreferrer">打开文章</a>
    </div>
  )}

  {deleted && <div class="admin-alert admin-alert--ok">已删除，对应的 md 文件已从内容目录移除。</div>}

  {problems.length > 0 && (
    <div class="admin-alert admin-alert--error">
      <strong>有 {problems.length} 个文件的 frontmatter 有问题，未显示在网站上：</strong>
      <ul>
        {problems.map((problem) => (
          <li>
            <code>src/content/blog/{problem.id}.md</code>：{problem.message}
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="admin-actions" style="margin: 1.25rem 0;">
    <a class="btn btn--primary" href="/admin/editor/">写新文章</a>
    <a class="btn" href="/blog/" target="_blank" rel="noreferrer">查看文章列表</a>
    <a class="btn" href="/tags/" target="_blank" rel="noreferrer">查看标签</a>
  </div>

  <div class="admin-panel">
    {
      posts.length === 0 ? (
        <p style="margin: 0; color: var(--text-soft);">
          还没有文章。点上面的「写新文章」开始吧。
        </p>
      ) : (
        <table class="admin-table">
          <thead>
            <tr>
              <th>标题</th>
              <th>状态</th>
              <th>日期</th>
              <th>标签</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr>
                <td>
                  <a href={postUrl(post)} target="_blank" rel="noreferrer">
                    {post.data.title}
                  </a>
                  <div style="color: var(--text-mute); font-size: 0.82rem;">{post.id}.md</div>
                </td>
                <td>
                  {post.data.draft ? (
                    <span class="admin-status admin-status--draft">草稿</span>
                  ) : (
                    <span class="admin-status admin-status--live">已发布</span>
                  )}
                </td>
                <td style="white-space: nowrap;">{isoDate(post.data.pubDate)}</td>
                <td>
                  {post.data.tags.length === 0
                    ? '—'
                    : post.data.tags.map((tag, index) => (
                        <>
                          {index > 0 && ' '}
                          <a class="tag" href={tagUrl(tag)} target="_blank" rel="noreferrer">
                            #{tag}
                          </a>
                        </>
                      ))}
                </td>
                <td>
                  <div class="admin-table__actions">
                    <a class="btn" href={`/admin/editor/?id=${encodeURIComponent(post.id)}`}>
                      编辑
                    </a>
                    <button
                      class="btn btn--danger"
                      type="button"
                      data-delete-id={post.id}
                      data-delete-title={post.data.title}
                    >
                      删除
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>

  <p style="color: var(--text-mute); font-size: 0.88rem;">
    每篇文章都是 <code>src/content/blog/</code> 下的一个 md 文件：在这里保存相当于生成/覆盖文件，
    你也可以直接用编辑器改这些文件，网站同样会立即更新。
  </p>

  <script>
    const idPath = (id: string) =>
      id
        .split('/')
        .filter(Boolean)
        .map((segment) => encodeURIComponent(segment))
        .join('/');

    document.querySelectorAll('[data-delete-id]').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.getAttribute('data-delete-id') ?? '';
        const title = button.getAttribute('data-delete-title') ?? id;

        if (!confirm(`确定删除《${title}》吗？\n\n对应的 md 文件会被移除，文章随即从网站消失。`)) return;

        (button as HTMLButtonElement).disabled = true;
        const response = await fetch(`/api/posts/${idPath(id)}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });

        if (response.ok) {
          location.href = '/admin/?deleted=1';
        } else {
          const data = await response.json().catch(() => ({}));
          alert((data.errors ?? ['删除失败']).join('\n'));
          (button as HTMLButtonElement).disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
