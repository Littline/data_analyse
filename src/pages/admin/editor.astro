---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPost } from '../../lib/posts';
import { isoDate, postUrl } from '../../utils/format';

const editId = Astro.url.searchParams.get('id') ?? '';
const post = editId ? await getPost(editId, { includeDrafts: true }) : null;
const missing = Boolean(editId) && !post;

const now = new Date();
const pad = (value: number) => String(value).padStart(2, '0');
const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

const initial = post
  ? {
      id: post.id,
      title: post.data.title,
      description: post.data.description ?? '',
      pubDate: isoDate(post.data.pubDate),
      updatedDate: post.data.updatedDate ? isoDate(post.data.updatedDate) : '',
      tags: post.data.tags.join(', '),
      category: post.data.category ?? '',
      cover: post.data.cover ?? '',
      draft: post.data.draft,
      featured: post.data.featured,
      body: post.body.replace(/^\n+/, ''),
    }
  : {
      id: '',
      title: '',
      description: '',
      pubDate: today,
      updatedDate: '',
      tags: '',
      category: '',
      cover: '',
      draft: false,
      featured: false,
      body: '',
    };

// 注意转义 <，避免正文里出现 </script> 提前结束标签
const initialJson = JSON.stringify(initial).replace(/</g, '\\u003c');
---

<AdminLayout title={post ? `编辑：${post.data.title}` : '写新文章'}>
  <h1 class="page-title" style="margin-top: 1.5rem;">
    {post ? '编辑文章' : '写新文章'}
  </h1>
  <p class="page-subtitle">
    {
      post ? (
        <>
          正在编辑 <code>src/content/blog/{post.id}.md</code> ·{' '}
          <a href={postUrl(post)} target="_blank" rel="noreferrer">
            查看文章
          </a>
        </>
      ) : (
        <>保存后会自动在 <code>src/content/blog/</code> 下生成 md 文件，并立刻出现在网站上。</>
      )
    }
  </p>

  {missing && (
    <div class="admin-alert admin-alert--error">
      没有找到要编辑的文章（<code>{editId}</code>），可能已经被删除。保存会当作新文章创建。
    </div>
  )}

  <form class="admin-form" id="post-form" novalidate>
    <div class="admin-field admin-field--row">
      <div class="admin-field">
        <label for="f-title">标题（必填）</label>
        <input type="text" id="f-title" maxlength="150" placeholder="文章标题" />
      </div>
      <div class="admin-field">
        <label for="f-id">文件名 / 网址</label>
        <input type="text" id="f-id" placeholder="my-first-post" />
        <span class="hint" id="url-hint">留空会按标题自动生成</span>
      </div>
    </div>

    <div class="admin-field">
      <label for="f-description">摘要（可选，用于列表页与搜索结果）</label>
      <input type="text" id="f-description" maxlength="400" placeholder="一句话说明这篇文章讲什么" />
    </div>

    <div class="admin-field admin-field--row">
      <div class="admin-field">
        <label for="f-pubDate">发布日期</label>
        <input type="date" id="f-pubDate" />
      </div>
      <div class="admin-field">
        <label for="f-updatedDate">更新日期（可选）</label>
        <input type="date" id="f-updatedDate" />
        <span class="hint">内容有改动时留空会自动填成今天</span>
      </div>
      <div class="admin-field">
        <label for="f-tags">标签（用逗号分隔）</label>
        <input type="text" id="f-tags" placeholder="Astro, 教程" />
      </div>
      <div class="admin-field">
        <label for="f-category">分类（可选）</label>
        <input type="text" id="f-category" placeholder="技术笔记" />
      </div>
    </div>

    <div class="admin-field admin-field--row">
      <div class="admin-field">
        <label for="f-cover">封面图（可选）</label>
        <input type="text" id="f-cover" placeholder="/images/cover.jpg 或图片外链" />
      </div>
      <div class="admin-field">
        <label>发布状态</label>
        <div class="admin-checkboxes">
          <label><input type="checkbox" id="f-draft" /> 存为草稿（不在网站公开）</label>
          <label><input type="checkbox" id="f-featured" /> 首页推荐</label>
        </div>
      </div>
    </div>

    <div class="editor-grid editor-grid--split">
      <div class="admin-field">
        <label for="f-body">正文（Markdown）</label>
        <div class="editor-toolbar">
          <button type="button" data-before="## " data-after="" data-placeholder="小标题">标题</button>
          <button type="button" data-before="**" data-after="**" data-placeholder="加粗文字">加粗</button>
          <button type="button" data-before="*" data-after="*" data-placeholder="斜体文字">斜体</button>
          <button type="button" data-before="`" data-after="`" data-placeholder="代码">行内代码</button>
          <button type="button" data-before="[" data-after="](https://)" data-placeholder="链接文字">链接</button>
          <button type="button" data-before="![图片说明](" data-after=")" data-placeholder="/images/图片名.jpg">图片</button>
          <button type="button" data-before={'\n```\n'} data-after={'\n```\n'} data-placeholder="代码块">代码块</button>
          <button type="button" data-before="> " data-after="" data-placeholder="引用内容">引用</button>
          <button type="button" data-before="- " data-after="" data-placeholder="列表项">列表</button>
          <button type="button" data-before="---\n\n" data-after="" data-placeholder="">分隔线</button>
        </div>
        <textarea id="f-body" placeholder="在这里写正文，支持标准 Markdown 语法"></textarea>
        <span class="hint">右侧会实时预览。Ctrl / ⌘ + S 也可以保存。</span>
      </div>

      <div class="admin-field">
        <p class="editor-preview__label">实时预览</p>
        <div class="editor-preview prose" id="preview">
          <p style="color: var(--text-mute);">开始输入后这里会显示渲染效果。</p>
        </div>
      </div>
    </div>

    <div id="form-errors"></div>

    <div class="admin-actions">
      <button class="btn btn--primary" type="submit" id="save-button">保存并发布</button>
      <a class="btn" href="/admin/">返回列表</a>
      {
        post && (
          <button class="btn btn--danger" type="button" id="delete-button">
            删除这篇文章
          </button>
        )
      }
    </div>
  </form>

  <script type="application/json" id="editor-initial" is:inline set:html={initialJson} />

  <script>
    type InitialData = {
      id: string;
      title: string;
      description: string;
      pubDate: string;
      updatedDate: string;
      tags: string;
      category: string;
      cover: string;
      draft: boolean;
      featured: boolean;
      body: string;
    };

    const initial: InitialData = JSON.parse(
      document.getElementById('editor-initial')?.textContent || '{}',
    );

    const field = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const form = field<HTMLFormElement>('post-form');
    const titleEl = field<HTMLInputElement>('f-title');
    const idEl = field<HTMLInputElement>('f-id');
    const descriptionEl = field<HTMLInputElement>('f-description');
    const pubDateEl = field<HTMLInputElement>('f-pubDate');
    const updatedDateEl = field<HTMLInputElement>('f-updatedDate');
    const tagsEl = field<HTMLInputElement>('f-tags');
    const categoryEl = field<HTMLInputElement>('f-category');
    const coverEl = field<HTMLInputElement>('f-cover');
    const draftEl = field<HTMLInputElement>('f-draft');
    const featuredEl = field<HTMLInputElement>('f-featured');
    const bodyEl = field<HTMLTextAreaElement>('f-body');
    const hintEl = field<HTMLElement>('url-hint');
    const previewEl = field<HTMLElement>('preview');
    const errorEl = field<HTMLElement>('form-errors');
    const saveButton = field<HTMLButtonElement>('save-button');
    const deleteButton = document.getElementById('delete-button') as HTMLButtonElement | null;

    /** 编辑已有文章时，文件名默认不动；新建时跟随标题自动生成 */
    let originalId = initial.id || '';
    let idTouched = Boolean(initial.id);
    let dirty = false;
    let previewTimer: number | undefined;

    const slugify = (value: string) =>
      value
        .normalize('NFKD')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80);

    const today = () => {
      const now = new Date();
      const pad = (value: number) => String(value).padStart(2, '0');
      return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    };

    const idPath = (id: string) =>
      id
        .split('/')
        .filter(Boolean)
        .map((segment) => encodeURIComponent(segment))
        .join('/');

    function updateHint() {
      const id = idEl.value.trim().replace(/^\/+|\/+$/g, '');
      hintEl.textContent = id ? `访问地址：/blog/${id}/` : '留空会按标题自动生成';
    }

    function markDirty() {
      dirty = true;
    }

    function showErrors(messages: string[]) {
      errorEl.innerHTML =
        messages.length === 0
          ? ''
          : `<div class="admin-alert admin-alert--error"><strong>保存失败：</strong><ul>${messages
              .map((message) => `<li>${message.replace(/[<>&]/g, (c) => `&#${c.charCodeAt(0)};`)}</li>`)
              .join('')}</ul></div>`;
      if (messages.length > 0) errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function payload() {
      const resolveUpdatedDate = () => {
        const value = updatedDateEl.value.trim();
        if (value) return value;
        // 编辑已有文章、且正文/标题有改动时，自动补上更新日期
        const changed =
          originalId !== '' &&
          (bodyEl.value.trim() !== initial.body.trim() || titleEl.value.trim() !== initial.title);
        return changed ? today() : '';
      };

      return {
        id: idEl.value.trim().replace(/^\/+|\/+$/g, ''),
        title: titleEl.value.trim(),
        description: descriptionEl.value.trim(),
        pubDate: pubDateEl.value || today(),
        updatedDate: resolveUpdatedDate(),
        tags: tagsEl.value,
        category: categoryEl.value.trim(),
        cover: coverEl.value.trim(),
        draft: draftEl.checked,
        featured: featuredEl.checked,
        body: bodyEl.value,
      };
    }

    async function save() {
      saveButton.disabled = true;
      saveButton.textContent = '保存中…';
      showErrors([]);

      try {
        const url = originalId ? `/api/posts/${idPath(originalId)}` : '/api/posts';
        const response = await fetch(url, {
          method: originalId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload()),
        });
        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          showErrors(data.errors ?? ['保存失败，请稍后再试']);
          return;
        }

        dirty = false;
        location.href = `/admin/?saved=${encodeURIComponent(data.id)}`;
      } catch (error) {
        showErrors([`网络错误：${(error as Error).message}`]);
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = '保存并发布';
      }
    }

    async function runPreview() {
      try {
        const response = await fetch('/api/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body: bodyEl.value }),
        });
        const data = await response.json();
        previewEl.innerHTML = data.html || '<p style="color: var(--text-mute);">（正文是空的）</p>';
      } catch {
        previewEl.innerHTML = '<p style="color: var(--text-mute);">预览暂时不可用</p>';
      }
    }

    function schedulePreview() {
      window.clearTimeout(previewTimer);
      previewTimer = window.setTimeout(runPreview, 500);
    }

    // 回填表单
    titleEl.value = initial.title || '';
    idEl.value = initial.id || '';
    descriptionEl.value = initial.description || '';
    pubDateEl.value = initial.pubDate || today();
    updatedDateEl.value = initial.updatedDate || '';
    tagsEl.value = initial.tags || '';
    categoryEl.value = initial.category || '';
    coverEl.value = initial.cover || '';
    draftEl.checked = Boolean(initial.draft);
    featuredEl.checked = Boolean(initial.featured);
    bodyEl.value = initial.body || '';
    updateHint();

    titleEl.addEventListener('input', () => {
      if (!idTouched) {
        idEl.value = slugify(titleEl.value);
        updateHint();
      }
      markDirty();
      schedulePreview();
    });

    idEl.addEventListener('input', () => {
      idTouched = idEl.value.trim() !== '';
      updateHint();
      markDirty();
    });

    bodyEl.addEventListener('input', () => {
      markDirty();
      schedulePreview();
    });

    form.addEventListener('input', markDirty);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void save();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        void save();
      }
    });

    // 工具栏：在光标处插入 Markdown 片段
    document.querySelectorAll<HTMLButtonElement>('.editor-toolbar button').forEach((button) => {
      button.addEventListener('click', () => {
        const before = button.dataset.before ?? '';
        const after = button.dataset.after ?? '';
        const placeholder = button.dataset.placeholder ?? '';
        const start = bodyEl.selectionStart;
        const end = bodyEl.selectionEnd;
        const selected = bodyEl.value.slice(start, end) || placeholder;

        bodyEl.value =
          bodyEl.value.slice(0, start) + before + selected + after + bodyEl.value.slice(end);
        bodyEl.focus();
        bodyEl.setSelectionRange(start + before.length, start + before.length + selected.length);

        markDirty();
        schedulePreview();
      });
    });

    deleteButton?.addEventListener('click', async () => {
      if (!originalId) return;
      if (!confirm(`确定删除《${titleEl.value || originalId}》吗？\n\n对应的 md 文件会被移除。`)) return;

      deleteButton.disabled = true;
      const response = await fetch(`/api/posts/${idPath(originalId)}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
      });

      if (response.ok) {
        dirty = false;
        location.href = '/admin/?deleted=1';
      } else {
        const data = await response.json().catch(() => ({}));
        showErrors(data.errors ?? ['删除失败']);
        deleteButton.disabled = false;
      }
    });

    window.addEventListener('beforeunload', (event) => {
      if (dirty) {
        event.preventDefault();
        event.returnValue = '';
      }
    });

    // 打开已有文章时先渲染一次预览
    if (bodyEl.value.trim()) schedulePreview();
  </script>
</AdminLayout>
